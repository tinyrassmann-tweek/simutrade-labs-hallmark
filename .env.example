# Set these as server environment variables; .env is not automatically loaded.
PORT=3000
# Local SQLite is the default when GOOGLE_CLOUD_PROJECT is absent.
# In Cloud Run this must be set; the runtime service account needs Firestore access.
# GOOGLE_CLOUD_PROJECT=your-project-id
# ADMIN_EMAIL=your-owner-email
# ADMIN_ACCESS_TOKEN=set-through-secret-manager
# Optional, billable third-party integrations (not required for included replay/templates):
# TWELVE_DATA_API_KEY=
# GEMINI_API_KEY=
# GEMINI_MODEL=choose-an-available-model
